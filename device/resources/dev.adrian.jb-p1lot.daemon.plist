<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.adrian.jb-p1lot.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/jb-p1lot-daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/mobile/Library/Logs/jb-p1lot-daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/Logs/jb-p1lot-daemon.err.log</string>
</dict>
</plist>
